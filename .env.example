# ==============================================================================
# OVEC GURU - Environment Configuration Example
# Target Server: CentOS Stream 9 | Xeon X3440 (No AVX) | ~3.6 GB RAM
# Storage Policy: ALL persistent data, uploads, temp & cache MUST live under /home/ovec_guru
# ==============================================================================

# --- Application ---
APP_NAME="OVEC GURU"
APP_ENV="production"
APP_DEBUG="false"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Database (PostgreSQL + pgvector) ---
# Option A: Local PostgreSQL + pgvector via Docker (deploy/docker-compose.postgres.yml)
DATABASE_URL="postgresql+psycopg2://ovec_guru:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/ovec_guru"

# Option B: Supabase Cloud (uncomment and fill in your connection string)
# DATABASE_URL="postgresql+psycopg2://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Local PostgreSQL Docker Credentials (used only when running Option A) ---
POSTGRES_DB="ovec_guru"
POSTGRES_USER="ovec_guru"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
PGDATA_DIR="/home/ovec_guru/pgdata"

# --- Cloud AI API (OpenAI-Compatible: No Local PyTorch / No AVX Required) ---
# Examples for AI_API_BASE_URL:
#   OpenAI:  https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
#   Typhoon: https://api.opentyphoon.ai/v1
AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_API_KEY="CHANGE_ME_YOUR_API_KEY"
AI_CHAT_MODEL="gemini-2.5-flash"
AI_EMBEDDING_MODEL="text-embedding-004"

# Vector dimension must match AI_EMBEDDING_MODEL output:
#   Gemini text-embedding-004        -> 768
#   OpenAI text-embedding-3-small    -> 1536
#   OpenAI text-embedding-3-large    -> 3072
AI_EMBEDDING_DIMENSIONS="768"

# --- Storage Paths (Strictly under /home/ovec_guru to protect 4.7 GB root partition) ---
UPLOAD_DIR="/home/ovec_guru/uploads"
TEMP_DIR="/home/ovec_guru/tmp"
CACHE_DIR="/home/ovec_guru/cache"
LOG_DIR="/home/ovec_guru/logs"

# --- Authentication & Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="480"

# --- Initial Primary Super Admin Bootstrap (used by init_db.py on first run) ---
INIT_SUPER_ADMIN_NAME="ผู้ดูแลระบบหลัก สอศ."
INIT_SUPER_ADMIN_EMAIL="admin@ovec.go.th"
INIT_SUPER_ADMIN_PASSWORD="ChangeMe@OVEC2026!"
INIT_SUPER_ADMIN_DEPARTMENT="สำนักงานคณะกรรมการการอาชีวศึกษา (สอศ.)"
